# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/synctube

# Frontend origin allowed to connect (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Room settings
ROOM_INACTIVITY_TIMEOUT_MINUTES=60

# How long (ms) a disconnected participant's slot is held open,
# waiting for them to reconnect (e.g. a page refresh) before they're
# treated as having actually left and host is auto-transferred.
PARTICIPANT_RECONNECT_GRACE_MS=10000
